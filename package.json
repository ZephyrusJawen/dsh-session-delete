{
  "name": "dsh-session-delete",
  "version": "0.1.1-rc2",
  "description": "Delete a DeepSeek Harness session from the sidebar: a plugin bundle that adds a session-row menu entry and permanently removes the stored session log.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZephyrusJawen/dsh-session-delete.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/host-logic.test.mjs && node test/client-wiring.test.mjs && node test/cordis-registration.test.mjs && node test/cordis-client-fibers.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2"
  }
}
